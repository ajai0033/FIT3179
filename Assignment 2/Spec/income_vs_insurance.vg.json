{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Scatter: median equivalised household income (weekly) vs % privately insured by LGA. Bubble size = population.",
    "title": "Median equivalised household income (weekly) vs % privately insured — by LGA",
    "autosize": {"type": "fit", "contains": "padding"},
    "width": "container",
    "height": 520,
  
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Assignment_2/LGA_Health_population.csv",
      "format": {"type": "csv", "trim": true}
    },
  
    "params": [
      {
        "name": "sizeFilter",
        "value": "all",
        "bind": {
          "input": "select",
          "name": "Population size: ",
          "options": ["all", "Small (<5k)", "Medium (5k–50k)", "Large (>50k)"],
          "labels": ["All", "Small (<5k)", "Medium (5k–50k)", "Large (>50k)"]
        }
      }
    ],
  
    "transform": [
      {
        "calculate": "datum['Population (2022)'] == null || datum['Population (2022)'] === '' ? null : toNumber(replace(datum['Population (2022)'], ',', ''))",
        "as": "population"
      },
      {
        "calculate": "datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == null || datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] === '' ? 0 : toNumber(replace(datum['Persons who reported having private health insurance (no.) (Data year: 2022)'], ',', ''))",
        "as": "insured"
      },
      {
        "calculate": "datum.population == null || datum.population == 0 ? null : (datum.insured / datum.population) * 100",
        "as": "pct_insured"
      },
      {
        "lookup": "Local Government Areas 2021 code",
        "from": {
          "data": {
            "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Assignment_2/Income_by_lga.csv",
            "format": {"type": "csv", "trim": true}
          },
          "key": "Local Government Areas 2021 code",
          "fields": ["Median equivalised total household income (weekly) ($) (Data year: 2021)"]
        }
      },
  
      {
        "calculate": "datum['Median equivalised total household income (weekly) ($) (Data year: 2021)'] == null || datum['Median equivalised total household income (weekly) ($) (Data year: 2021)'] === '' ? null : toNumber(replace(datum['Median equivalised total household income (weekly) ($) (Data year: 2021)'], ',', ''))",
        "as": "median_equiv_income_weekly"
      },
  
      {
        "calculate": "datum.population == null ? null : (datum.population < 5000 ? 'Small (<5k)' : (datum.population < 50000 ? 'Medium (5k–50k)' : 'Large (>50k)'))",
        "as": "size_cat"
      },
  
      {
        "calculate": "'' + datum['Local Government Areas 2021 code']",
        "as": "lga_code"
      },
      {
        "calculate": "datum['Local Government Areas 2021 name']",
        "as": "lga_name"
      },
      {
        "filter": "sizeFilter == 'all' || datum.size_cat == sizeFilter"
      },
      {
        "filter": "datum.median_equiv_income_weekly != null && isFinite(datum.median_equiv_income_weekly) && datum.pct_insured != null && isFinite(datum.pct_insured)"
      }
    ],
  
    "mark": {"type": "point", "filled": true, "opacity": 0.85},
  
    "encoding": {
      "x": {
        "field": "median_equiv_income_weekly",
        "type": "quantitative",
        "title": "Median equivalised household income (weekly) ($)",
        "axis": {"format": "$,d"}
      },
  
      "y": {
        "field": "pct_insured",
        "type": "quantitative",
        "title": "Percent with Private Health Insurance (%)",
        "axis": {"format": ".1f"}
      },
  
      "size": {
        "field": "population",
        "type": "quantitative",
        "scale": {"domain": [1000, 300000], "range": [40, 2500], "clamp": true},
        "legend": {"title": "Population (bubble area)", "orient": "right"}
      },
  
      "color": {
        "field": "size_cat",
        "type": "nominal",
        "scale": {"domain": ["Small (<5k)", "Medium (5k–50k)", "Large (>50k)"], "range": ["#66c2a5", "#fc8d62", "#8da0cb"]},
        "legend": {"title": "Population category"}
      },
  
      "tooltip": [
        {"field": "lga_name", "type": "nominal", "title": "LGA"},
        {"field": "population", "type": "quantitative", "title": "Population", "format": ",d"},
        {"field": "pct_insured", "type": "quantitative", "title": "% insured", "format": ".1f"},
        {"field": "median_equiv_income_weekly", "type": "quantitative", "title": "Median equivalised income (weekly $)", "format": "$,d"},
        {"field": "size_cat", "type": "nominal", "title": "Population category"}
      ]
    },
  
    "config": {
      "view": {"stroke": "transparent"},
      "axis": {"labelFontSize": 12, "titleFontSize": 13},
      "legend": {"labelFontSize": 12, "titleFontSize": 13}
    }
  }
  