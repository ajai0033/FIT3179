{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "KPI tiles: national % insured, mean disability %, mean carers %, total population, LGAs >=50%, LGAs <50%",
    "autosize": {"type": "fit", "contains": "padding"},
    "hconcat": [
      {
        "width": 300,
        "height": 110,
        "data": {
          "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Week-10-Homework/LGA_Health_population.csv",
          "format": {"type": "csv", "trim": true}
        },
        "transform": [
          {
            "calculate": "datum['Persons with disability (%) (Data year: 2018)'] == null || datum['Persons with disability (%) (Data year: 2018)'] == '' ? null : +datum['Persons with disability (%) (Data year: 2018)']",
            "as": "disability_pct"
          },
          {"aggregate": [{"op": "mean", "field": "disability_pct", "as": "mean_disability_pct"}]}
        ],
        "layer": [
          {
            "mark": {"type": "text", "fontSize": 36, "fontWeight": "bold", "dy": -6},
            "encoding": {
              "text": {"field": "mean_disability_pct", "type": "quantitative", "format": ".1f"},
              "tooltip": [
                {"field": "mean_disability_pct", "type": "quantitative", "title": "Mean disability %", "format": ".1f"}
              ]
            }
          },
          {
            "mark": {"type": "text", "fontSize": 14, "dy": 18, "color": "#555"},
            "encoding": {"text": {"value": "Mean disability % (2018)"}}
          }
        ]
      },
  
      {
        "width": 300,
        "height": 110,
        "data": {
          "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Week-10-Homework/LGA_Health_population.csv",
          "format": {"type": "csv", "trim": true}
        },
        "transform": [
          {
            "calculate": "datum['Persons who are carers (%) (Data year: 2018)'] == null || datum['Persons who are carers (%) (Data year: 2018)'] == '' ? null : +datum['Persons who are carers (%) (Data year: 2018)']",
            "as": "carers_pct"
          },
          {"aggregate": [{"op": "mean", "field": "carers_pct", "as": "mean_carers_pct"}]}
        ],
        "layer": [
          {
            "mark": {"type": "text", "fontSize": 36, "fontWeight": "bold", "dy": -6},
            "encoding": {
              "text": {"field": "mean_carers_pct", "type": "quantitative", "format": ".1f"},
              "tooltip": [
                {"field": "mean_carers_pct", "type": "quantitative", "title": "Mean carers %", "format": ".1f"}
              ]
            }
          },
          {
            "mark": {"type": "text", "fontSize": 14, "dy": 18, "color": "#555"},
            "encoding": {"text": {"value": "Mean carers % (2018)"}}
          }
        ]
      },
  
      {
        "width": 300,
        "height": 110,
        "data": {
          "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Week-10-Homework/LGA_Health_population.csv",
          "format": {"type": "csv", "trim": true}
        },
        "transform": [
          {
            "calculate": "datum['Population (2022)'] == null || datum['Population (2022)'] == '' ? null : +datum['Population (2022)']",
            "as": "population"
          },
          {
            "calculate": "datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == null || datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == '' ? 0 : +datum['Persons who reported having private health insurance (no.) (Data year: 2022)']",
            "as": "insured"
          },
          {"calculate": "datum.population == null || datum.population == 0 ? null : (datum.insured / datum.population) * 100", "as": "pct_insured"},
          {"filter": "datum.pct_insured >= 50"},
          {"aggregate": [{"op": "count", "as": "lgas_ge_50"}]}
        ],
        "layer": [
          {
            "mark": {"type": "text", "fontSize": 36, "fontWeight": "bold", "dy": -6},
            "encoding": {
              "text": {"field": "lgas_ge_50", "type": "quantitative", "format": "d"},
              "tooltip": [
                {"field": "lgas_ge_50", "type": "quantitative", "title": "LGAs >= 50% insured"}
              ]
            }
          },
          {
            "mark": {"type": "text", "fontSize": 14, "dy": 18, "color": "#555"},
            "encoding": {"text": {"value": "LGAs with >= 50% insured"}}
          }
        ]
      },
  
      {
        "width": 300,
        "height": 110,
        "data": {
          "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Week-10-Homework/LGA_Health_population.csv",
          "format": {"type": "csv", "trim": true}
        },
        "transform": [
          {
            "calculate": "datum['Population (2022)'] == null || datum['Population (2022)'] == '' ? null : +datum['Population (2022)']",
            "as": "population"
          },
          {
            "calculate": "datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == null || datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == '' ? 0 : +datum['Persons who reported having private health insurance (no.) (Data year: 2022)']",
            "as": "insured"
          },
          {"calculate": "datum.population == null || datum.population == 0 ? null : (datum.insured / datum.population) * 100", "as": "pct_insured"},
          {"filter": "datum.pct_insured < 50"},
          {"aggregate": [{"op": "count", "as": "lgas_lt_50"}]}
        ],
        "layer": [
          {
            "mark": {"type": "text", "fontSize": 36, "fontWeight": "bold", "dy": -6},
            "encoding": {
              "text": {"field": "lgas_lt_50", "type": "quantitative", "format": "d"},
              "tooltip": [
                {"field": "lgas_lt_50", "type": "quantitative", "title": "LGAs < 50% insured"}
              ]
            }
          },
          {
            "mark": {"type": "text", "fontSize": 14, "dy": 18, "color": "#555"},
            "encoding": {"text": {"value": "LGAs with < 50% insured"}}
          }
        ]
      }
    ],
    "config": {
      "view": {"stroke": "transparent"},
      "axis": {"labelFontSize": 11, "titleFontSize": 12},
      "background": "#E6F3FF"
    }
  }
  