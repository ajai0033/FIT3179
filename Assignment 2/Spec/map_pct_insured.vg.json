{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "% Insured — by LGA",
    "width": 900,
    "height": 700,
    "projection": {"type": "mercator"},
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/Week-9-Homework/LGA_2021_AUST_GDA2020.json",
      "format": {"type": "topojson", "feature": "LGA_2021_AUST_GDA2020"}
    },
    "transform": [
      {
        "lookup": "properties.LGA_CODE21",
        "from": {
          "data": {
            "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Assignment_2/LGA_Insurance_pop.csv"
          },
          "key": "Local Government Areas 2021 code",
          "fields": ["Insured Pct"]
        }
      },
      {
        "calculate": "datum['Insured Pct'] == null ? null : +datum['Insured Pct']",
        "as": "pct_insured"
      }
    ],
    "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
    "encoding": {
      "color": {
        "field": "pct_insured",
        "type": "quantitative",
        "scale": {"type": "quantile"},
        "title": "% insured"
      },
      "tooltip": [
        {"field": "properties.LGA_NAME21", "type": "nominal", "title": "LGA"},
        {"field": "pct_insured", "type": "quantitative", "title": "% insured", "format": ".1f"}
      ]
    }
  }
  