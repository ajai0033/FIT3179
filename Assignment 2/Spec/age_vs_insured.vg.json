{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Mirrored bar chart showing mean % insured by Age Group and Sex. 'All States' shows mean across states.",
    "width": "container",
    "autosize": { "type": "fit", "contains": "padding" },
    "height": 400,
  
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Assignment_2/Age_insured_by_state.csv",
      "format": {"type": "csv", "trim": true}
    },
  
    "params": [
      {
        "name": "state_selection",
        "value": null,
        "bind": {
          "input": "select",
          "name": "Filter by State: ",
          "options": [null, "ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],
          "labels": ["All States", "ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"]
        }
      }
    ],
  
    "transform": [
      {
        "calculate": "datum['Pct Insured'] == null || datum['Pct Insured'] === '' ? null : toNumber(replace(datum['Pct Insured'], '%', ''))",
        "as": "PctInsuredNum"
      },
      {
        "filter": "datum.PctInsuredNum != null && isFinite(datum.PctInsuredNum)"
      },
      {
        "filter": "!state_selection || datum.State == state_selection"
      },
      {
        "calculate": "datum.Sex === 'Males' || datum.Sex === 'Male' ? 'Male' : 'Female'",
        "as": "NormalizedSex"
      },
      {
        "aggregate": [
          {"op": "mean", "field": "PctInsuredNum", "as": "PctInsuredMean"}
        ],
        "groupby": ["Age Group", "NormalizedSex"]
      },
      {
        "calculate": "datum.NormalizedSex === 'Male' ? -datum.PctInsuredMean : datum.PctInsuredMean",
        "as": "PctSigned"
      },
      {
        "calculate": "abs(datum.PctSigned)",
        "as": "PctAbs"
      },
      {
        "calculate": "trim(datum['Age Group'])",
        "as": "AgeGroupTrim"
      },
      {
        "calculate": "toNumber(split(datum.AgeGroupTrim, /[^0-9]/)[0])",
        "as": "age_start_num"
      }
    ],
  
    "layer": [
      {
        "mark": {
          "type": "bar",
          "cornerRadius": 3,
          "opacity": 0.95
        },
        "encoding": {
          "y": {
            "field": "Age Group",
            "type": "ordinal",
            "sort": {"field": "age_start_num", "order": "descending"},
            
            "axis": {
              "title": "Age Group",
              "labelAngle": 0,
              "labelFontSize": 12
            }
          },
          "x": {
            "field": "PctSigned",
            "type": "quantitative",
            "title": "← Males (%)     |     Percent Insured     |     Females (%) →",
            "scale": {"domain": [-70, 70]},
            "axis": {
              "labelExpr": "abs(datum.value) + '%'",
              "values": [-70, -60, -50, -40, -30, -20, -10, 0, 10, 20, 30, 40, 50, 60, 70],
              "grid": true,
              "labelFontSize": 11
            }
          },
          "color": {
            "field": "NormalizedSex",
            "type": "nominal",
            "scale": {
              "domain": ["Male", "Female"],
              "range": ["#1f77b4", "#ff7f0e"]
            },
            "legend": {"title": "Sex", "orient": "bottom"}
          },
          "tooltip": [
            {"field": "Age Group", "type": "ordinal", "title": "Age group"},
            {"field": "NormalizedSex", "type": "nominal", "title": "Sex"},
            {"field": "PctInsuredMean", "type": "quantitative", "title": "Mean % Insured", "format": ".2f"}
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 6,
          "fontSize": 11
        },
        "encoding": {
          "y": {"field": "Age Group", "type": "ordinal", "sort": "descending"},
          "x": {
            "field": "PctSigned",
            "type": "quantitative",
            "scale": {"domain": [-70, 70]}
          },
          "text": {"field": "PctAbs", "type": "quantitative", "format": ".1f"},
          "color": {
            "condition": {
                "test": "datum.NormalizedSex === 'Male'",
                "value": "#FFFFFF"
            },
            "value": "#000"}
        }
      },
      {
        "mark": {"type": "rule", "stroke": "#000", "strokeWidth": 1},
        "encoding": {"x": {"datum": 0}}
      }
    ],
  
    "config": {
      "view": {"stroke": "transparent"},
      "axis": {"labelFontSize": 11, "titleFontSize": 13},
      "legend": {"labelFontSize": 11, "titleFontSize": 12},
      "background": "#E6F3FF"
    }
  }