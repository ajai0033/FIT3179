{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Heatmap showing hospital bed density by state and remoteness category.",
    "title": "Public Hospital Beds per 1,000 People by State and Remoteness",
    "width": 400,
    "height": 350,
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Assignment_2/state_remote_density.csv"
    },
  
    "mark": {"type": "rect", "stroke": "white", "strokeWidth": 1},
  
    "encoding": {
      "x": {
        "field": "Remoteness",
        "type": "ordinal",
        "title": "Remoteness Category",
        "axis": {"labelAngle": 40, "labelFontSize": 11}
      },
      "y": {
        "field": "State",
        "type": "ordinal",
        "title": "State",
        "axis": {"labelFontSize": 12}
      },
      "color": {
        "field": "Density",
        "type": "quantitative",
        "title": "Beds per 1,000 People",
        "scale": {"scheme": "blues"},
        "legend": {"orient": "right"}
      },
      "tooltip": [
        {"field": "State", "type": "nominal"},
        {"field": "Remoteness", "type": "nominal"},
        {"field": "Density", "type": "quantitative", "title": "Beds per 1,000", "format": ".2f"}
      ]
    },
  
    "config": {
      "view": {"stroke": "transparent"},
      "axis": {"labelFontSize": 12, "titleFontSize": 13},
      "legend": {"labelFontSize": 12, "titleFontSize": 13}
    }
  }
  