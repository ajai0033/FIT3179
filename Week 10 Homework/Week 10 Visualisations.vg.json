{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Scatter plot of % private health insurance vs population by LGA",
    "width": 900,
    "height": 600,
    "title": "Private Health Insurance (%) vs Population by LGA (2022)",
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/Week-10-Homework/LGA_Health_Insurance_Clean.csv",
      "format": {"type": "csv", "trim": true}
    },
    "transform": [
      {
        "lookup": "lga_code",
        "from": {
          "data": {
            "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/Week-10-Homework/LGA_Population_2022_Clean.csv",
            "format": {"type": "csv", "trim": true}
          },
          "key": "lga_code",
          "fields": ["population"]
        }
      },
      {
        "calculate": "datum.insured == null ? 0 : +datum.insured",
        "as": "insured"
      },
      {
        "calculate": "datum.population == null ? null : +datum.population",
        "as": "population"
      },
      {
        "calculate": "datum.insured / datum.population * 100",
        "as": "pct_insured"
      }
    ],
    "mark": {"type": "circle", "tooltip": true},
    "encoding": {
      "x": {
        "field": "population",
        "type": "quantitative",
        "title": "Population (2022)",
        "scale": {"type": "log"}
      },
      "y": {
        "field": "pct_insured",
        "type": "quantitative",
        "title": "Percent with Private Health Insurance (%)"
      },
      "size": {
        "field": "population",
        "type": "quantitative",
        "legend": {"title": "Population size"}
      },
      "color": {
        "field": "pct_insured",
        "type": "quantitative",
        "scale": {"scheme": "blues"},
        "legend": {"title": "% Insured"}
      },
      "tooltip": [
        {"field": "lga_name", "type": "nominal", "title": "LGA"},
        {"field": "population", "type": "quantitative", "title": "Population"},
        {"field": "insured", "type": "quantitative", "title": "Number Insured"},
        {"field": "pct_insured", "type": "quantitative", "title": "% Insured", "format": ".1f"}
      ]
    }
  }
  