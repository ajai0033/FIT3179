{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Persons with disability (%) by LGA (2018) — filterable",
    "width": 800,
    "height": 700,
    "params": [
      {
        "name": "minPct",
        "value": 0,
        "bind": {
          "input": "range",
          "min": 0,
          "max": 40,
          "step": 0.1,
          "name": "Minimum disability % to show: "
        }
      }
    ],
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/Week-9-Homework/LGA_hlth_disab_DbR_Nov24_-7869466443108774970%20%282%29.csv",
      "format": {"type": "csv"}
    },
    "transform": [
      {
        "calculate": "datum[\"Persons with disability (%) (Data year: 2018)\"] == null ? null : +datum[\"Persons with disability (%) (Data year: 2018)\"]",
        "as": "persons_with_disability_pct"
      },
      {"calculate": "datum[\"Local Government Areas 2021 name\"]", "as": "lga_name"},
      {"filter": "datum.persons_with_disability_pct != null && datum.persons_with_disability_pct >= minPct"}
    ],
    "mark": "bar",
    "encoding": {
      "y": {
        "field": "lga_name",
        "type": "ordinal",
        "sort": {"field": "persons_with_disability_pct", "order": "descending"},
        "title": "LGA",
        "axis": {"labelLimit": 250, "labelFontSize": 10}
      },
      "x": {
        "field": "persons_with_disability_pct",
        "type": "quantitative",
        "title": "Persons with disability (%) (2018)",
        "axis": {"format": ".1f"}
      },
      "color": {
        "field": "persons_with_disability_pct",
        "type": "quantitative",
        "scale": {"scheme": "blues"},
        "legend": null
      },
      "tooltip": [
        {"field": "lga_name", "type": "nominal", "title": "LGA"},
        {
          "field": "persons_with_disability_pct",
          "type": "quantitative",
          "title": "Disability %",
          "format": ".1f"
        }
      ]
    }
  }
  