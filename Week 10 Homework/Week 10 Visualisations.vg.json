{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Scatter: percent private health insurance vs population — fixed (no String() calls).",
    "width": 900,
    "height": 600,
    "title": "Private Health Insurance (%) vs Population by LGA (2022)",
    "data": {
      "url": "https://raw.githubusercontent.com/ajai0033/FIT3179/refs/heads/Week-10-Homework/LGA_Health_population.csv",
      "format": {"type": "csv", "trim": true}
    },
    "transform": [
      {
        "calculate": "datum['Population (2022)'] == null || datum['Population (2022)'] == '' ? null : +(('' + datum['Population (2022)']).replace(/[^0-9.]/g, ''))",
        "as": "population"
      },
      {
        "calculate": "datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == null || datum['Persons who reported having private health insurance (no.) (Data year: 2022)'] == '' ? 0 : +(('' + datum['Persons who reported having private health insurance (no.) (Data year: 2022)']).replace(/[^0-9.]/g, ''))",
        "as": "insured"
      },
      {
        "calculate": "datum.population == null || datum.population == 0 ? null : (datum.insured / datum.population) * 100",
        "as": "pct_insured"
      },
      {
        "calculate": "datum['Local Government Areas 2021 name']",
        "as": "lga_name"
      },
      {
        "calculate": "datum['Local Government Areas 2021 code'] == null || datum['Local Government Areas 2021 code'] == '' ? null : ('' + datum['Local Government Areas 2021 code'])",
        "as": "lga_code"
      },
      {
        "filter": "datum.population != null && datum.population > 0"
      }
    ],
    "selection": {
      "sel": {
        "type": "single",
        "fields": ["lga_code"],
        "on": "click",
        "empty": "all"
      }
    },
    "mark": {"type": "point", "tooltip": true, "filled": true},
    "encoding": {
      "x": {
        "field": "population",
        "type": "quantitative",
        "title": "Population (2022)",
        "scale": {"type": "log", "nice": true}
      },
      "y": {
        "field": "pct_insured",
        "type": "quantitative",
        "title": "Percent with Private Health Insurance (%)",
        "axis": {"format": ".1f"}
      },
      "size": {
        "field": "population",
        "type": "quantitative",
        "legend": {"title": "Population size"},
        "scale": {"range": [50, 2500]}
      },
      "color": {
        "field": "pct_insured",
        "type": "quantitative",
        "scale": {"scheme": "blues"},
        "legend": {"title": "% insured"}
      },
      "opacity": {
        "condition": {"selection": "sel", "value": 1},
        "value": 0.35
      },
      "tooltip": [
        {"field": "lga_name", "type": "nominal", "title": "LGA"},
        {"field": "lga_code", "type": "nominal", "title": "LGA code"},
        {"field": "population", "type": "quantitative", "title": "Population (2022)"},
        {"field": "insured", "type": "quantitative", "title": "Number insured"},
        {"field": "pct_insured", "type": "quantitative", "title": "% insured", "format": ".1f"}
      ]
    }
  }
  